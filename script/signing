#!/bin/bash
# Print the Apple team this checkout signs with, or nothing. The team
# lives in the gitignored Signing.xcconfig, which the version xcconfig
# includes so Xcode's iPhone builds use it too; when the file is
# missing it is written from Xcode's provisioning profiles for the
# app's identifier, if they name exactly one team. A profile, unlike a
# certificate, proves the team may provision the identifier, so a
# contributor on another team keeps building ad hoc. Never in the
# sandbox, which must not touch keychains or the host's profiles.
set -euo pipefail

cd "$(dirname "$0")/.."

file=Signing.xcconfig
if [[ ! -f "${file}" && -z "${SV_SESSION_ID:-}" ]]; then
  teams="$(
    for profile in "${HOME}/Library/Developer/Xcode/UserData/Provisioning Profiles/"* \
      "${HOME}/Library/MobileDevice/Provisioning Profiles/"*; do
      if [[ -f "${profile}" ]]; then
        security cms -D -i "${profile}" 2>/dev/null || true
      fi
    done |
      sed -n 's|^[[:space:]]*<string>\([[:alnum:]]\{10\}\)\.com\.mikemcquaid\.Sanductor</string>$|DEVELOPMENT_TEAM = \1|p' |
      sort -u
  )"
  if [[ -n "${teams}" && "${teams}" != *$'\n'* ]]; then
    printf '%s\n' "// Written by script/signing from this Mac's Sanductor provisioning profile." \
      "${teams}" >"${file}"
  elif [[ -n "${teams}" ]]; then
    echo "Several teams have Sanductor provisioning profiles; write one to ${file}:" >&2
    echo "${teams}" >&2
  fi
fi

if [[ -f "${file}" ]]; then
  sed -n 's/^DEVELOPMENT_TEAM *= *//p' "${file}"
fi
