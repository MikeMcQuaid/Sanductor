@@ -120,6 +120,20 @@

       for line in lines {
         for run in line {
+          if let intent = run[InlinePresentationIntentAttribute.self]?.intent, let ctRun = run.ctRun
+          {
+            let stringRange = CTRunGetStringRange(ctRun)
+            if stringRange.location >= 0, stringRange.length > 0,
